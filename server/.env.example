PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Leave empty to use an ephemeral MongoDB instance locally. Use a real MongoDB
# connection string when you need data to persist between backend restarts.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-development-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12
MAX_FILE_MB=10
UPLOAD_DIR=

# AI defaults to a deterministic local mock. Set AI_PROVIDER=openai and add a key only when approved.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_MAX_TOKENS=1200
AI_TIMEOUT=30000
